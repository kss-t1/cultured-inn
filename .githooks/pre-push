#!/usr/bin/env bash
# Runs the same checks as `bun run verify` before every push. Skip once with `git push --no-verify`.
set -euo pipefail
# git exports GIT_DIR and friends to hooks; unset them so tests that run git see a normal environment.
# shellcheck disable=SC2046
unset $(git rev-parse --local-env-vars 2>/dev/null) 2>/dev/null || true
cd "$(git rev-parse --show-toplevel)"
echo "pre-push: bun run verify"
bun run verify
