# Postgres connection (role and DBs: see README "Local setup")
DATABASE_URL=postgres://kss:karczma-dev@localhost:5432/karczma
# Used by `bun test`; must point at a database whose name ends in _test (it gets wiped)
TEST_DATABASE_URL=postgres://kss:karczma-dev@localhost:5432/karczma_test

# Public origin of the site; mutating admin requests must carry this Origin
PUBLIC_BASE_URL=http://localhost:3000
PORT=3000

# Long random string (e.g. `openssl rand -base64 48`); keys the session-token HMAC
SESSION_SECRET=change-me

# Set to 1 when running behind Caddy so X-Forwarded-For is used as the client IP
TRUST_PROXY=0

# M3: LLM extraction for "import from URL"
ANTHROPIC_API_KEY=
